{
  "schemaVersion": 1,
  "id": "schematic_builder",
  "version": "${version}",
  "name": "Schematic Builder Assistant",
  "description": "A visible, user-controlled building assistant for Litematica schematics.",
  "authors": ["Codex"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.codex.schematicbuilder.SchematicBuilderClient"]
  },
  "suggests": {
    "litematica": "*",
    "malilib": "*"
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
